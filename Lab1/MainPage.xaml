<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1.MainPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <!-- Colors -->
        <Color x:Key="ColorDarkest">#0B161E</Color>
        <Color x:Key="ColorDark">#51625C</Color>
        <Color x:Key="ColorMedium">#A6B9BE</Color>
        <Color x:Key="ColorLight">#D8D2C6</Color>
        <Color x:Key="ColorAccent">#4F6734</Color>

        <!-- Button style -->
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent}" />
            <Setter Property="TextColor" Value="{StaticResource ColorLight}" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Main menu -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="10" BackgroundColor="{StaticResource ColorDark}">
            <Button Text="Зберегти" Clicked="OnSaveClicked" />
            <Button Text="Завантажити" Clicked="OnLoadClicked" />
            <Button Text="Допомога" Clicked="OnHelpClicked" />
            <Button x:Name="ModeButton" Text="Режим: Значення" Clicked="OnModeToggled" />
            <Button Text="Очистити клітинку" Clicked="OnClearCellClicked" />
            <Button Text="Очистити таблицю" Clicked="OnClearTableClicked" />
            <Label Text="Стовпці:" VerticalOptions="Center" TextColor="{StaticResource ColorLight}" FontAttributes="Bold" Margin="10,0,0,0"/>
            <Entry x:Name="ColCountEntry" Text="10" WidthRequest="40" TextColor="{StaticResource ColorDarkest}" Keyboard="Numeric" BackgroundColor="White" />

            <Label Text="Рядки:" VerticalOptions="Center" TextColor="{StaticResource ColorLight}" FontAttributes="Bold"/>
            <Entry x:Name="RowCountEntry" Text="10" WidthRequest="40" TextColor="{StaticResource ColorDarkest}" Keyboard="Numeric" BackgroundColor="White" />

            <Button Text="Змінити розмір" Clicked="OnResizeClicked" />
        </HorizontalStackLayout>

        <!-- Expression box -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Padding="10" BackgroundColor="{StaticResource ColorMedium}">
            <Label x:Name="CurrentCellLabel" Text="A1" VerticalOptions="Center" FontAttributes="Bold" Margin="0,0,10,0" WidthRequest="40" TextColor="{StaticResource ColorDarkest}" />
            <Entry x:Name="FormulaEntry" Grid.Column="1" Placeholder="Введіть формулу..." ReturnType="Done" TextColor="{StaticResource ColorDarkest}" />
            <Button Grid.Column="2" Text="Застосувати" Clicked="OnCalculateClicked" Margin="10,0,0,0" />
        </Grid>

        <!-- Spreadsheet container -->
        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="SpreadsheetGrid" Padding="5" RowSpacing="1" ColumnSpacing="1" BackgroundColor="{StaticResource ColorLight}" />
        </ScrollView>

    </Grid>
</ContentPage>